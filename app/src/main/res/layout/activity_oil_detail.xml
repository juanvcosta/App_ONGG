<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oilDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OilDetailActivity">

    <!-- Header com botão voltar à esquerda -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:padding="12dp"
        android:src="?attr/homeAsUpIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Texto Introdutório Centralizado -->
            <TextView
                android:id="@+id/tvOilIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="O óleo essencial de lavanda é extraído das flores da planta de lavanda e possui uma variedade de benefícios terapêuticos."
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="#424242" />

            <!-- Imagem de Destaque Larga -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOilImageContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp">

                <ImageView
                    android:id="@+id/ivOilImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Imagem do Óleo"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Seção BENEFÍCIOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="BENEFÍCIOS"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutBenefitsChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#FCE4EC"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvChip1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="Melhora o sono"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#C2185B"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chip 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#FCE4EC"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvChip2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="Reduz o estresse e a ansiedade"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#C2185B"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chip 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#FCE4EC"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvChip3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="Alivia dores musculares"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#C2185B"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chip 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#FCE4EC"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvChip4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="Ação calmante"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="#C2185B"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Seção COMO USAR? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="COMO USAR?"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutHowToUse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Tópico 1: Massagem -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• MASSAGEM:"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMassageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="4dp"
                        android:text="dilua algumas gotas de óleo de lavanda em um óleo transportador, como óleo de coco ou amêndoa, e massageie suavemente a pele para relaxar os músculos e aliviar os sintomas."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#424242" />
                </LinearLayout>

                <!-- Tópico 2: Inalação -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• INALAÇÃO:"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInhalationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="4dp"
                        android:text="pingue 1 ou 2 gotas do óleo nas palmas das mãos, esfregue levemente, aproxime do nariz e respire profundamente por alguns segundos."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#424242" />
                </LinearLayout>

                <!-- Tópico 3: Escalda-pés -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• ESCALDA-PÉS:"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFootBathInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="4dp"
                        android:text="adicione 5 gotas em uma bacia com água morna e mergulhe os pés por 15 minutos para aliviar os sintomas."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#424242" />
                </LinearLayout>

            </LinearLayout>

            <!-- Card de Aviso com Ícone de Alerta Amarelo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFF8E1"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#FFE082"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvWarningText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Sempre dilua o óleo em um óleo transportador antes de aplicar na pele e evite o contato com os olhos."
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="#5D4037" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>